// CRM schema. Mirrors client/src/types/crm.ts — when one changes, change both.
//
// Everything lives in the `crm` schema (set via ?schema=crm in DATABASE_URL)
// so it stays isolated from anything else on this Postgres instance.

generator client {
  provider = "prisma-client-js"
}

// Connection URL lives in prisma.config.ts (Prisma 7 requirement).
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- Users

enum UserRole {
  admin
  manager
  rep
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(rep)
  avatarColor  String   @default("primary")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedLeads     Lead[]         @relation("LeadOwner")
  ownedDeals     Deal[]         @relation("DealOwner")
  ownedCampaigns Campaign[]     @relation("CampaignOwner")
  assignedTasks  Task[]         @relation("TaskAssignee")
  uploads        Document[]     @relation("DocumentUploader")
  activities     Activity[]     @relation("ActivityActor")
  emailAccounts  EmailAccount[] @relation("EmailAccountOwner")
  emailMessages  EmailMessage[] @relation("EmailMessageOwner")
  extractions    Extraction[]   @relation("ExtractionAuthor")
  reviewedChanges ProposedChange[] @relation("ProposalReviewer")
  refreshTokens  RefreshToken[]
  notifications  Notification[]

  @@map("users")
}

/// In-app notification, created by the automation engine (and future system
/// events). Read/unread drives the header bell.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String   @default("")
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@map("notifications")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------- Accounts

enum CompanyStatus {
  active
  lead
  churned
}

model Company {
  id        String        @id @default(cuid())
  name      String
  industry  String        @default("")
  website   String        @default("")
  location  String        @default("")
  status    CompanyStatus @default(lead)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  contacts   Contact[]
  deals      Deal[]
  activities Activity[]
  documents  Document[]
  emails     EmailMessage[]

  @@index([status])
  @@map("companies")
}

enum ContactStatus {
  Active
  Inactive
  Pending
}

model Contact {
  id        String        @id @default(cuid())
  name      String
  jobTitle  String        @default("")
  email     String
  phone     String        @default("")
  companyId String?
  company   Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  status    ContactStatus @default(Active)
  tags      String[]      @default([])

  // Value objects, stored inline rather than as their own tables.
  address Json @default("{}")
  social  Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities      Activity[]
  deals           Deal[]
  tasks           Task[]
  documents       Document[]
  emails          EmailMessage[]
  conversations   Conversation[]
  campaignMembers CampaignMember[]
  convertedFrom   Lead[]           @relation("LeadConvertedContact")

  // Duplicate detection is a soft check in the API, not a hard constraint —
  // the UI deliberately lets you proceed past a warning.
  @@index([email])
  @@index([companyId])
  @@index([status])
  @@map("contacts")
}

// ---------------------------------------------------------------- Leads

enum LeadSource {
  web
  referral
  event
  outreach
  campaign
  other
}

enum LeadStatus {
  new
  contacted
  qualified
  unqualified
  converted
}

model Lead {
  id             String     @id @default(cuid())
  name           String
  jobTitle       String     @default("")
  email          String
  phone          String     @default("")
  /// Free text — a lead's company isn't an account until conversion.
  companyName    String     @default("")
  source         LeadSource @default(web)
  status         LeadStatus @default(new)
  ownerId        String?
  owner          User?      @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  estimatedValue Decimal?   @db.Decimal(12, 2)
  notes          String     @default("")

  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  convertedContactId String?
  convertedContact   Contact? @relation("LeadConvertedContact", fields: [convertedContactId], references: [id], onDelete: SetNull)
  convertedCompanyId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  activities      Activity[]
  tasks           Task[]
  documents       Document[]
  emails          EmailMessage[]
  campaignMembers CampaignMember[]

  @@index([status])
  @@index([ownerId])
  @@index([source])
  @@index([deletedAt])
  @@map("leads")
}

// ---------------------------------------------------------------- Deals

enum DealStage {
  New
  Contacted
  Qualified
  Negotiation
  Won
  Lost
}

model Deal {
  id        String    @id @default(cuid())
  title     String
  reference String    @unique
  contactId String?
  contact   Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  companyId String?
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  ownerId   String?
  owner     User?     @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  amount    Decimal   @default(0) @db.Decimal(12, 2)
  currency  String    @default("USD")
  stage     DealStage @default(New)
  /// 0-100. Moves with `stage` unless overridden.
  probability       Int       @default(10)
  expectedCloseDate DateTime?
  closedAt          DateTime?
  notes             String    @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks     Task[]
  documents Document[]

  @@index([stage])
  @@index([companyId])
  @@index([ownerId])
  @@map("deals")
}

// ---------------------------------------------------------------- Activities

enum ActivityType {
  call
  email
  meeting
  note
  inquiry
  created
  status_change
}

enum ActivityStatus {
  logged
  planned
}

enum ActivityDirection {
  inbound
  outbound
}

model Activity {
  id        String   @id @default(cuid())
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  /// Denormalized on write so history survives the contact being reassigned.
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  type      ActivityType
  status    ActivityStatus     @default(logged)
  direction ActivityDirection?
  summary   String
  body      String?

  /// When it happened. Also the timeline sort key.
  at              DateTime
  scheduledAt     DateTime?
  durationMinutes Int?

  actorId String?
  actor   User?   @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contactId, at])
  @@index([leadId, at])
  // The account rollup sorts on this pair.
  @@index([companyId, at])
  @@index([status, scheduledAt])
  @@map("activities")
}

// ---------------------------------------------------------------- Tasks

enum TaskPriority {
  Low
  Medium
  High
  Urgent
}

enum TaskStatus {
  backlog
  todo
  in_progress @map("in-progress")
  done
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String       @default("")
  priority    TaskPriority @default(Medium)
  status      TaskStatus   @default(todo)

  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  dueDate DateTime?

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  checklists  TaskChecklist[]
  comments    TaskComment[]
  attachments TaskAttachment[]

  @@index([status])
  @@index([assigneeId])
  @@index([dueDate])
  @@map("tasks")
}

model TaskChecklist {
  id     String              @id @default(cuid())
  taskId String
  task   Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title  String
  items  TaskChecklistItem[]

  @@index([taskId])
  @@map("task_checklists")
}

model TaskChecklistItem {
  id          String        @id @default(cuid())
  checklistId String
  checklist   TaskChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  text        String
  completed   Boolean       @default(false)

  @@index([checklistId])
  @@map("task_checklist_items")
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text      String
  authorId  String?
  createdAt DateTime @default(now())

  @@index([taskId])
  @@map("task_comments")
}

model TaskAttachment {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  name   String
  url    String
  type   String

  @@index([taskId])
  @@map("task_attachments")
}

// ---------------------------------------------------------------- Email

enum EmailProvider {
  gmail
  outlook
  imap
}

enum EmailStatus {
  draft
  queued
  sent
  failed
}

model EmailAccount {
  id           String        @id @default(cuid())
  address      String        @unique

  /// The mailbox belongs to whoever connected it; nobody else may see it.
  userId String?
  user   User?   @relation("EmailAccountOwner", fields: [userId], references: [id], onDelete: Cascade)
  provider     EmailProvider
  displayName  String
  connected    Boolean       @default(false)
  lastSyncedAt DateTime?
  /// OAuth tokens land here once mailbox connection is built. Never returned by the API.
  credentials  Json?
  createdAt    DateTime      @default(now())

  messages EmailMessage[]

  @@map("email_accounts")
}

model EmailTemplate {
  id        String   @id @default(cuid())
  name      String
  subject   String
  /// HTML from the TipTap editor.
  body      String
  category  String   @default("General")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages  EmailMessage[]
  campaigns Campaign[]

  @@map("email_templates")
}

model EmailMessage {
  id        String        @id @default(cuid())

  /// Sender/owner of the message. Messages are private to this user.
  userId String?
  user   User?   @relation("EmailMessageOwner", fields: [userId], references: [id], onDelete: Cascade)

  accountId String?
  account   EmailAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  subject String
  body    String
  from    String
  to      String[] @default([])
  cc      String[] @default([])

  templateId String?
  template   EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  status    EmailStatus @default(draft)
  sentAt    DateTime?
  openedAt  DateTime?
  clickedAt DateTime?
  createdAt DateTime    @default(now())

  @@index([contactId])
  @@index([leadId])
  @@index([status])
  @@index([userId])
  @@map("email_messages")
}

// ---------------------------------------------------------------- Conversations

enum Channel {
  chat
  email
  sms
}

model Conversation {
  id          String  @id @default(cuid())
  contactId   String
  contact     Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channel     Channel @default(chat)
  online      Boolean @default(false)
  unreadCount Int     @default(0)

  createdAt DateTime  @default(now())
  messages  Message[]

  @@index([contactId])
  @@map("conversations")
}

enum MessageAuthor {
  me
  them
}

enum MessageStatus {
  sent
  delivered
  read
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author         MessageAuthor
  body           String
  at             DateTime      @default(now())
  status         MessageStatus @default(sent)

  @@index([conversationId, at])
  @@map("messages")
}

// ---------------------------------------------------------------- Documents

enum DocumentCategory {
  proposal
  quote
  contract
  other
}

model Document {
  id        String           @id @default(cuid())
  name      String
  mimeType  String
  sizeBytes BigInt
  category  DocumentCategory @default(other)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)

  uploadedById String
  uploadedBy   User   @relation("DocumentUploader", fields: [uploadedById], references: [id])

  /// Object key in Supabase Storage. Bytes never touch Postgres.
  storageKey String?
  uploadedAt DateTime @default(now())

  @@index([contactId])
  @@index([companyId])
  @@index([leadId])
  @@index([dealId])
  @@map("documents")
}

// ---------------------------------------------------------------- Campaigns

enum CampaignType {
  email
  event
  webinar
  social
  other
}

enum CampaignStatus {
  draft
  scheduled
  active
  paused
  completed
}

model Campaign {
  id        String         @id @default(cuid())
  name      String
  type      CampaignType   @default(email)
  status    CampaignStatus @default(draft)
  startDate DateTime
  endDate   DateTime?
  goal      String         @default("")
  budget    Decimal?       @db.Decimal(12, 2)

  ownerId String?
  owner   User?   @relation("CampaignOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  templateId String?
  template   EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members CampaignMember[]
  leads   Lead[]

  @@index([status])
  @@map("campaigns")
}

enum CampaignResponse {
  none
  opened
  clicked
  replied
  converted
}

model CampaignMember {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)

  response CampaignResponse @default(none)
  addedAt  DateTime         @default(now())

  // The UI assumes exactly one of contactId/leadId is set. A CHECK constraint
  // enforcing that is added by migration — Prisma can't express it natively.
  @@unique([campaignId, contactId])
  @@unique([campaignId, leadId])
  @@index([campaignId])
  @@map("campaign_members")
}

// ---------------------------------------------------------------- Automation

enum TriggerEntity {
  contact
  lead
  deal
  task
  campaign
}

enum TriggerEvent {
  created
  updated
  stage_changed
  inactive_for
}

model AutomationRule {
  id          String  @id @default(cuid())
  name        String
  description String  @default("")
  enabled     Boolean @default(false)

  triggerEntity TriggerEntity
  triggerEvent  TriggerEvent

  /// Schemaless by design; validated with Zod against lib/automationSchema.
  conditions Json @default("[]")
  actions    Json @default("[]")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  lastRunAt DateTime?

  runs AutomationRun[]

  @@index([enabled])
  @@map("automation_rules")
}

/// Execution history. Debugging automation without this is miserable.
model AutomationRun {
  id       String         @id @default(cuid())
  ruleId   String
  rule     AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  ranAt    DateTime       @default(now())
  matched  Boolean
  /// Which record triggered it, and what the actions did.
  context  Json           @default("{}")
  error    String?

  @@index([ruleId, ranAt])
  @@map("automation_runs")
}

// ---------------------------------------------------------------- AI proposals

enum ProposalEntity {
  contact
  lead
  deal
  task
  activity
}

enum ProposalAction {
  create_record
  update_field
  move_stage
  change_status
  log_activity
  create_task
}

enum ProposalStatus {
  pending
  approved
  rejected
  applied
  failed
}

/// One pasted input — an email thread, a transcript, a chat export — and the
/// changes Claude proposed from it. Nothing here has touched a CRM record yet.
model Extraction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("ExtractionAuthor", fields: [userId], references: [id], onDelete: Cascade)
  sourceLabel String   @default("")
  /// Kept so a reviewer can always see what a proposal was derived from.
  rawText     String
  summary     String   @default("")
  createdAt   DateTime @default(now())

  changes ProposedChange[]

  @@index([userId, createdAt])
  @@map("extractions")
}

/// A single reviewable change. Applied only on approval, and only through the
/// normal service layer so validation, ownership and automations all still run.
model ProposedChange {
  id           String     @id @default(cuid())
  extractionId String
  extraction   Extraction @relation(fields: [extractionId], references: [id], onDelete: Cascade)

  entity   ProposalEntity
  action   ProposalAction
  /// Null for a create. Resolved server-side — the model never emits an id.
  targetId String?
  /// Human-readable name for the row, e.g. "Deal stage" or "New stakeholder".
  label    String
  field    String?
  /// Snapshot taken when proposed; the left side of the diff, and the value
  /// re-checked on approval so a stale proposal cannot clobber a newer edit.
  currentValue  String?
  proposedValue String?
  /// Full arguments for the service call, validated with Zod before applying.
  payload  Json    @default("{}")
  /// The quoted snippet this came from. This is what makes a proposal reviewable.
  evidence String  @default("")

  status       ProposalStatus @default(pending)
  reviewedById String?
  reviewedBy   User?          @relation("ProposalReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  appliedAt    DateTime?
  error        String?
  createdAt    DateTime       @default(now())

  @@index([status])
  @@index([extractionId])
  @@map("proposed_changes")
}
