{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "prisma generate",
  "outputDirectory": "public",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/automations/run",
      "schedule": "*/5 * * * *"
    }
  ]
}
