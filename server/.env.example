# Copy to .env and fill in. Never commit .env — only this file.

NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------- Database
# Postgres. Managed providers (Aiven, Supabase, Neon) require sslmode=require.
# Give the CRM its own database or schema rather than sharing one.
DATABASE_URL="postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require&schema=crm"

# ---------------------------------------------------------------- Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12
AUTH_COOKIE_NAME=refreshToken
# Set to "none" when the frontend and API are on different origins (e.g.
# frontend on Vercel, API hosted elsewhere). "lax" is fine when same-site.
AUTH_COOKIE_SAMESITE=lax

# ---------------------------------------------------------------- Storage
# Supabase Storage exposes an S3-compatible API. Access keys are separate from
# the project anon/service keys — create them under Storage -> S3 access keys.
S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_REGION=ap-southeast-1
S3_BUCKET=crm-documents
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------- Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="CRM <no-reply@example.com>"
