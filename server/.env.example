# Copy to .env and fill in. Never commit .env — only this file.

NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------- Database
# Two connections, because they have different jobs.
#
# DATABASE_URL is what the running server uses (src/lib/prisma.ts). On a
# serverless host point it at a transaction-mode pooler so thousands of short
# lived function instances share a small number of Postgres connections.
# Supabase: Project Settings -> Database -> Connection pooling, port 6543.
#
# The URL is parsed by node-postgres (we use @prisma/adapter-pg), NOT by
# Prisma's own connector -- so Prisma-specific flags like `pgbouncer=true` are
# ignored, and TLS must be asked for explicitly or pg connects in plaintext.
# `uselibpqcompat=true` keeps sslmode=require meaning "encrypt" rather than
# pg's default of promoting it to verify-full, which needs Supabase's CA cert.
# Percent-encode the password if it contains @ : / ? # & or %.
DATABASE_URL="postgresql://postgres.<project-ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require&uselibpqcompat=true"
#
# DIRECT_URL is used only by the Prisma CLI (db push, migrate, seed, studio)
# via prisma.config.ts. DDL needs a real session, which a transaction pooler
# cannot give, so this points at the session pooler on port 5432. Optional —
# omit it for a plain single-instance Postgres and DATABASE_URL is used.
DIRECT_URL="postgresql://postgres.<project-ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true"
#
# The app keeps its tables in a `crm` schema, normally selected by a pg startup
# option. Transaction poolers may ignore or reject startup options, so set the
# search_path on the role once and leave PG_OPTIONS empty if that happens:
#   CREATE SCHEMA IF NOT EXISTS crm;
#   ALTER ROLE postgres IN DATABASE postgres SET search_path TO crm, public;
# PG_OPTIONS=

# ---------------------------------------------------------------- Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12
AUTH_COOKIE_NAME=refreshToken
# Set to "none" when the frontend and API are on different origins (e.g.
# frontend on Vercel, API hosted elsewhere). "lax" is fine when same-site.
AUTH_COOKIE_SAMESITE=lax
# Secret that Vercel's cron sends to POST /api/automations/run. Set it in the
# Vercel backend project env; Vercel forwards it as Authorization: Bearer.
CRON_SECRET=

# ---------------------------------------------------------------- Storage
# Supabase Storage exposes an S3-compatible API. Access keys are separate from
# the project anon/service keys — create them under Storage -> S3 access keys.
S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_REGION=ap-southeast-1
S3_BUCKET=crm-documents
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------- Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="CRM <no-reply@example.com>"
