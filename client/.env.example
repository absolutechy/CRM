# Copy to .env and fill in. Never commit .env — only this file.

# Base URL of the deployed backend API. When unset, the client calls the
# relative /api path (works in dev via the Vite proxy, and on Vercel only if
# you add an /api rewrite or run the API on the same origin).
#
# Set this in your Vercel project's environment variables as VITE_API_URL.
# Example: https://crm-api.your-domain.com  (no trailing slash)
VITE_API_URL=
